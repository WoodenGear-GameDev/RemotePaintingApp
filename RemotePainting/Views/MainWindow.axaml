<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RemotePainting.ViewModels"
        xmlns:v="using:RemotePainting.Views"

        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"

        x:Class="RemotePainting.Views.MainWindow"
        x:DataType="vm:MainRootViewModel"

        Width="1200"
        Height="800"
        CanResize="True"
        Background="#242224"

        Icon="/Assets/AppIcon.png"
        Title="Remote Painting">

    <Window.Styles>
        <Style Selector="Button.image-only-button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.image-only-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button.image-only-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="TextBox.chat-box">
            <Setter Property="Background" Value="#161416"/>
            <Setter Property="BorderBrush" Value="#ca80de"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="Transparent"/>
        </Style>

        <Style Selector="TextBox.chat-box:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#161416"/>
            <Setter Property="BorderBrush" Value="#ca80de"/>
        </Style>

        <Style Selector="TextBox.chat-box:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#161416"/>
            <Setter Property="BorderBrush" Value="#ca80de"/>
        </Style>

        <Style Selector="TextBox.message-box">
            <Setter Property="Background" Value="#161416"/>
            <Setter Property="BorderBrush" Value="#ca80de"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="TextBox.message-box:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#161416"/>
            <Setter Property="BorderBrush" Value="White"/>
        </Style>

        <Style Selector="TextBox.message-box:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#161416"/>
            <Setter Property="BorderBrush" Value="#ca80de"/>
        </Style>

        <Style Selector="TextBox.text-block">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <Style Selector="TextBox.text-block:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <Style Selector="TextBox.text-block:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <Style Selector="ToggleButton.icon-toggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="ToggleButton.icon-toggle:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="ToggleButton.icon-toggle:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    
        <Style Selector="ToggleButton.icon-toggle:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Styles>

    <Viewbox Stretch="Uniform">
        <Border Width="1200" Height="800" Background="#242224">
            <ContentControl Content="{Binding CurrentViewModel}">
                <ContentControl.DataTemplates>
          
                  <!-- 1. Если активен MainMenuViewModel, показываем MainMenuView -->
                  <DataTemplate DataType="vm:Menus.MainMenuVM">
                    <v:MainMenuView />
                  </DataTemplate>

                  <!-- 2. Если активен ServerListViewModel, показываем ServerListView -->
                  <DataTemplate DataType="vm:Menus.ServerListVM">
                    <v:ServerListView />
                  </DataTemplate>

              <!-- 3. Если активен CanvasViewModel, показываем CanvasView -->
              <DataTemplate DataType="vm:Menus.CanvasVM">
                <v:CanvasView />
              </DataTemplate>
                <DataTemplate DataType="vm:Menus.UsernameVM">
                    <v:UsernameView />
                </DataTemplate>

                </ContentControl.DataTemplates>
              </ContentControl>
        </Border>
    </Viewbox>
</Window>
