<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RemotePainting.ViewModels.Menus"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="RemotePainting.Views.MainMenuView"
             x:DataType="vm:MainMenuVM">
    <Grid>
       <Button Classes="image-only-button"
                    Command="{Binding ShowUsernameCommand}"
                    HotKey="Enter"
                    Width="50"
                    Height="50"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Margin="20">
                <Image Source="/Assets/user_2.png" Width="50" Height="50"/>
       </Button>

      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="15" Width="320">
        <Image Source="/Assets/AppIcon.png" Width="150" Height="150" HorizontalAlignment="Center" Margin="0,0,0,20"/>
        <TextBlock Text="Remote Painting" 
                   FontSize="32" 
                   FontWeight="Black"
                   Foreground="#ca80de"
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"/>
    
        <Button HorizontalContentAlignment="Left"
                VerticalContentAlignment="Center"
                Command="{Binding CreateServerCommand}" 
                Background="#ca80de"
                Foreground="White"
                HorizontalAlignment="Center"
                FontSize="16"
                FontWeight="Bold"
                Width="200" 
                Height="60">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <Image Source="/Assets/canvas.png" VerticalAlignment="Center" Width="35" Height="35" Margin="5"/>
                    <TextBlock Text="Create Canvas" VerticalAlignment="Center"/>
                </StackPanel>
        </Button>
    
        <Button Command="{Binding JoinServerCommand}"
                Background="#ca80de"
                Foreground="White"
                HorizontalContentAlignment="Left"
                VerticalContentAlignment="Center"
                HorizontalAlignment="Center"
                FontSize="16"
                FontWeight="Bold"
                Width="200" 
                Height="60">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <Image Source="/Assets/join.png" VerticalAlignment="Center" Width="35" Height="35" Margin="5"/>
                    <TextBlock Text="Join Server" VerticalAlignment="Center"/>
                </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
</UserControl>
