<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RemotePainting.ViewModels.Menus"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="RemotePainting.Views.MainMenuView"
             x:DataType="vm:MainMenuVM">

  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="15" Width="320">
    <TextBlock Text="Remote Painting" 
               FontSize="28" 
               FontWeight="Bold"
               Foreground="#ca80de"
               HorizontalAlignment="Center" 
               Margin="0,0,0,20"/>
    
    <Button Content="Create Canvas" 
            Command="{Binding CreateServerCommand}" 
            Background="#ca80de"
            Foreground="White"
            HorizontalAlignment="Stretch" 
            HorizontalContentAlignment="Center" 
            Height="45"/>
    
    <Button Content="Join Canvas" 
            Command="{Binding JoinServerCommand}"
            Background="#ca80de"
            Foreground="White"
            HorizontalAlignment="Stretch" 
            HorizontalContentAlignment="Center" 
            Height="45"/>
  </StackPanel>
  
</UserControl>
