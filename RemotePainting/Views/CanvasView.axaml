<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RemotePainting.ViewModels.Menus"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="RemotePainting.Views.CanvasView"
             x:DataType="vm:CanvasVM">

  <Grid RowDefinitions="Auto, *, Auto" Margin="20">

    <Border Grid.Row="1" 
            BorderBrush="#ca80de" 
            BorderThickness="2" 
            Background="#FAFAFA" 
            CornerRadius="8"
            Margin="0,15">
      <TextBlock Text="Здесь будет интерактивный холст для рисования"
                 VerticalAlignment="Center" 
                 HorizontalAlignment="Center" 
                 FontSize="16" 
                 Foreground="#ca80de"/>
    </Border>

    <Button Grid.Row="2" 
            Content="Quit" 
            Command="{Binding CloseCanvasCommand}"
            Foreground="White"
            Background="#ca80de"
            HorizontalAlignment="Left"/>
    
  </Grid>
  
</UserControl>