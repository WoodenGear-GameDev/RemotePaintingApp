<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RemotePainting.ViewModels.Menus"
             xmlns:controls="using:RemotePainting.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="RemotePainting.Views.CanvasView"
             x:DataType="vm:CanvasVM">

  <Grid RowDefinitions="Auto, *, Auto" Margin="20">

    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
      <ColorPicker Color="{Binding SelectedColor, Mode=TwoWay}" />
      <TextBlock Text="Толщина" VerticalAlignment="Center"/>
      <Slider Minimum="1" Maximum="40" Width="180"
              Value="{Binding Thickness, Mode=TwoWay}"
              VerticalAlignment="Center"/>
      <TextBlock Text="{Binding Thickness, StringFormat={}{0:0}}"
                 VerticalAlignment="Center" Width="24"/>
    </StackPanel>

    <Border Grid.Row="1"
            BorderBrush="#ca80de"
            BorderThickness="2"
            Background="White"
            CornerRadius="8"
            ClipToBounds="True"
            Margin="0,15">
      <controls:DrawingCanvas x:Name="Board"
                              BrushColor="{Binding SelectedColor}"
                              BrushThickness="{Binding Thickness}"/>
    </Border>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
      <Button Content="Quit"
              Command="{Binding CloseCanvasCommand}"
              Foreground="White"
              Background="#ca80de"/>
      <Button Content="Отменить" Click="Undo_Click"/>
      <Button Content="Очистить" Click="Clear_Click"/>
      <Button Content="Сохранить" Click="SavePng_Click"/>
    </StackPanel>

  </Grid>

</UserControl>
