<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RemotePainting.ViewModels.Menus"
             xmlns:controls="using:RemotePainting.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="RemotePainting.Views.CanvasView"
             x:DataType="vm:CanvasVM">

  <Grid RowDefinitions="Auto, *, Auto" ColumnDefinitions="*, Auto" Margin="20">

    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
      <ColorPicker Color="{Binding SelectedColor, Mode=TwoWay}"/>
      <TextBlock Text="Thickness" FontWeight="Bold" Foreground="#ca80de" VerticalAlignment="Center"/>
      <Slider Minimum="1" Maximum="40" Width="180"
              Value="{Binding Thickness, Mode=TwoWay}"
              VerticalAlignment="Center"/>
      <TextBlock Text="{Binding Thickness, StringFormat={}{0:0}}"
                 VerticalAlignment="Center" Width="24"/>
    </StackPanel>

    <Border Grid.Row="1"
            BorderBrush="#ca80de"
            BorderThickness="2"
            Background="White"
            CornerRadius="8"
            ClipToBounds="True"
            Margin="0,15">
      <controls:DrawingCanvas x:Name="Board"
                              BrushColor="{Binding SelectedColor}"
                              BrushThickness="{Binding Thickness}"/>
    </Border>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
      <Button Content="Quit"
              Command="{Binding CloseCanvasCommand}"
              Foreground="White"
              Background="#ca80de"/>
      <Button Content="Undo" Click="Undo_Click" HotKey="Ctrl+z"/>
      <Button Content="Clear" Click="Clear_Click"/>
      <Button Content="Save" Click="SavePng_Click"/>
    </StackPanel>

      <Grid RowDefinitions="*, Auto" Grid.Row="1" Grid.Column="1" Margin="15, 15, 0, 0">
          <TextBox Grid.Row="0"
                   Classes="chat-box"
                   Text="{Binding ChatHistory}"
                   BorderThickness="2"
                   VerticalAlignment="Stretch"
                   Width="250"
                   AcceptsReturn="True" 
                   TextWrapping="Wrap"
                   IsReadOnly="True"
                   VerticalContentAlignment="Bottom"
                   FontSize="12"
                   CornerRadius="8"/>
            <Grid Grid.Row="1" Margin="0, 5, 0, 15">
    
            <TextBox Classes="message-box"
                     Text="{Binding UserInput}"
                     BorderThickness="2"
                     Height="30"
                     Width="250"
                     AcceptsReturn="True" 
                     TextWrapping="Wrap"
                     FontSize="12"
                     CornerRadius="8"
                     Padding="5, 5, 20, 5"/>

            <Button Classes="image-only-button"
                    Command="{Binding SendUserMessageCommand}"
                    HotKey="Enter"
                    Width="24"
                    Height="24"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Margin="0, 0, 6, 0">
                <Image Source="/Assets/send.png" Width="22" Height="22"/>
            </Button>
    
        </Grid>


      </Grid>

  </Grid>

</UserControl>
