<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RemotePainting.ViewModels.Menus"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="RemotePainting.Views.ServerListView"
             x:DataType="vm:ServerListVM">

  <Grid RowDefinitions="Auto, *, Auto, Auto, Auto" Margin="25">
    
    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Spacing="10">
        <Image Source="/Assets/searching.png" Width="35" Height="35" Margin="0,0,0,10"/>
        
        <TextBlock 
               Text="Searching for local servers..." 
               FontSize="20" 
               FontWeight="Bold"
               Foreground="#ca80de"
               VerticalAlignment="Center"
               Margin="0,0,0,10"/>
    </StackPanel>

    <ListBox Grid.Row="1" 
             ItemsSource="{Binding DiscoveredServers}" 
             Margin="0,0,0,15"
             CornerRadius="8">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Button Content="{Binding HostName}" 
                  Command="{Binding $parent[UserControl].((vm:ServerListVM)DataContext).ConnectToServerCommand}"
                  CommandParameter="{Binding}"
                  HorizontalAlignment="Stretch" 
                  Margin="2"/>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <TextBlock Grid.Row="2" 
               Text="Connect by IP:"
               FontSize="16"
               FontWeight="Bold"
               Foreground="#ca80de"
               Margin="0, 5, 0, 5"/>

    <Grid Grid.Row="3" ColumnDefinitions="Auto, *, Auto">
        <TextBox Grid.Column="0"
            Classes="message-box"
            Text="{Binding IpAddress, Mode=TwoWay}"
            PlaceholderText="Enter server IP..."
            MaxLength="15"
            BorderThickness="2"
            Height="30"
            FontSize="14"
            CornerRadius="8"
            Padding="10, 5, 10, 5"
            Width="300"
            HorizontalAlignment="Left"
            VerticalContentAlignment="Center">
            <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding ConnectByIpCommand}"/>
            </TextBox.KeyBindings>
        </TextBox>
        <Button Grid.Column="1"
            Content="Connect"
            FontWeight="Bold"
            Command="{Binding ConnectByIpCommand}"
            Width="90"
            Foreground="White"
            Background="#ca80de"
            HorizontalContentAlignment="Center"
            Margin="10, 0, 0, 0"/>
        <Button Grid.Column="2"
            Content="Back"
            FontWeight="Bold"
            Command="{Binding BackToMainMenuCommand}"
            Width="90"
            Foreground="White"
            Background="#ca80de"
            HorizontalContentAlignment="Center"/>
    </Grid>

    <TextBlock Grid.Row="4"
               Text="{Binding ErrorMessage}"
               Foreground="Red"
               TextWrapping="Wrap"
               IsVisible="{Binding HasErrorMessage}"
               Margin="0, 5, 0, 0"/>
    
  </Grid>
  
</UserControl>