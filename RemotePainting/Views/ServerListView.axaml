<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RemotePainting.ViewModels.Menus"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="RemotePainting.Views.ServerListView"
             x:DataType="vm:ServerListVM">

  <Grid RowDefinitions="Auto, *, Auto" Margin="25">
    
    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Spacing="10">
        <Image Source="/Assets/searching.png" Width="35" Height="35" Margin="0,0,0,10"/>
        
        <TextBlock 
               Text="Searching for local servers..." 
               FontSize="20" 
               FontWeight="Bold"
               Foreground="#ca80de"
               VerticalAlignment="Center"
               Margin="0,0,0,10"/>
    </StackPanel>

    <ListBox Grid.Row="1" 
             ItemsSource="{Binding DiscoveredServers}" 
             Margin="0,0,0,15"
             CornerRadius="8">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Button Content="{Binding HostName}" 
                  Command="{Binding $parent[UserControl].((vm:ServerListVM)DataContext).ConnectToServerCommand}"
                  CommandParameter="{Binding}"
                  HorizontalAlignment="Stretch" 
                  Margin="2"/>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <StackPanel Grid.Row="2" 
                Orientation="Horizontal" 
                Spacing="10" 
                HorizontalAlignment="Right">
      <Button Content="Back"
              FontWeight="Bold"
              Command="{Binding BackToMainMenuCommand}"
              Width="90"
              Foreground="White"
              Background="#ca80de"
              HorizontalContentAlignment="Center"/>
    </StackPanel>
    
  </Grid>
  
</UserControl>